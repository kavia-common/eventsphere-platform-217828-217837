# Frontend environment example

# HTTP base of GraphQL backend (http:// or https://, NOT ws://). You may include /graphql or omit it.
# Examples:
#  - Local: http://localhost:4000
#  - Remote: https://your-backend.example.com
REACT_APP_BACKEND_URL=http://localhost:4000

# WS base for GraphQL subscriptions (ws:// for http backends; wss:// when frontend is https or backend is https).
# Do NOT include a custom path like /ws. The client will append /graphql automatically.
# Examples:
#  - Local (http): ws://localhost:4000
#  - Remote (https): wss://your-backend.example.com
REACT_APP_WS_URL=ws://localhost:4000

# Absolute URL for this frontend (used in docs/proxies; optional)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional single API base (used for both HTTP and WS when provided)
# REACT_APP_API_BASE=http://localhost:4000

# Optional flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS=chat,analytics
REACT_APP_EXPERIMENTS_ENABLED=false
