# Frontend Environment Variables (React - Create React App)
# Copy this file to `.env` and adjust values per environment (development/staging/production).

# Base URL for API usage on the client (optional convenience alias)
REACT_APP_API_BASE=http://localhost:4000

# Backend HTTP endpoint base (will be used as `${REACT_APP_BACKEND_URL}/graphql` by Apollo)
# Example (Render/Heroku): https://your-backend-service.onrender.com
REACT_APP_BACKEND_URL=http://localhost:4000

# Frontend site URL (useful for redirects, sharing links, or absolute URLs)
# Example (Vercel): https://your-frontend.vercel.app
REACT_APP_FRONTEND_URL=http://localhost:3000

# Backend WebSocket endpoint base (will be used as `${REACT_APP_WS_URL}/graphql` by Apollo for subscriptions)
# For local dev with ws: ws://localhost:4000 ; with SSL: wss://your-backend-service.onrender.com
REACT_APP_WS_URL=ws://localhost:4000

# Node environment indicator for the client (affects Apollo devtools)
# Allowed: development | production | test
REACT_APP_NODE_ENV=development

# Disable Next.js telemetry (kept for consistency in multi-repo setups; CRA ignores it but CI/CD may read it)
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Enable generation of source maps in production builds (true/false)
REACT_APP_ENABLE_SOURCE_MAPS=true

# Port for CRA dev server (npm start)
REACT_APP_PORT=3000

# Whether app is behind a proxy/CDN and should trust forwarded headers (true/false)
REACT_APP_TRUST_PROXY=false

# Client-side log level for custom logging utilities (silent|error|warn|info|debug|trace)
REACT_APP_LOG_LEVEL=info

# Healthcheck path the frontend may expose or ping (client utilities)
REACT_APP_HEALTHCHECK_PATH=/healthz

# Comma-separated feature flags to toggle UI features at runtime
# Example: chat,analytics,new-dashboard
REACT_APP_FEATURE_FLAGS=

# Toggle experiments or beta features (true/false)
REACT_APP_EXPERIMENTS_ENABLED=false
