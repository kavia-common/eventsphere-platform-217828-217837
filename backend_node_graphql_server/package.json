{
  "name": "backend_node_graphql_server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EventSphere Backend - Node.js GraphQL server skeleton with MongoDB (Mongoose)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --ext js,mjs,cjs --watch src src/index.js",
