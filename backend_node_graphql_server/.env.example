# Server configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
HEALTHCHECK_PATH=/healthz

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=changeme-in-prod

# Database
# Example for local MongoDB: mongodb://localhost:27017/eventsphere
# Example for MongoDB Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/eventsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/eventsphere

# Realtime (GraphQL WS)
WS_ENABLED=true
