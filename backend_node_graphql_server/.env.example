# MongoDB connection string (e.g., mongodb://localhost:27017/eventsphere)
MONGODB_URI=mongodb://localhost:27017/eventsphere

# JWT secret used for signing tokens
JWT_SECRET=please_change_me_super_secret

# Server config
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
WS_ENABLED=true
HEALTHCHECK_PATH=/healthz
LOG_LEVEL=info
