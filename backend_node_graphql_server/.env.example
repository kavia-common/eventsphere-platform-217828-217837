# EventSphere Backend - .env.example

# Required
MONGODB_URI=mongodb://localhost:27017/eventsphere
JWT_SECRET=change_me_dev_secret

# Optional
PORT=4000
NODE_ENV=development

# CORS: include the frontend origin(s) (comma-separated). For local dev:
CORS_ORIGIN=http://localhost:3000

# If using cross-container reference, frontend may also set REACT_APP_FRONTEND_URL.
# We prefer CORS_ORIGIN, but support fallback from REACT_APP_FRONTEND_URL if present.
REACT_APP_FRONTEND_URL=http://localhost:3000

# GraphQL Subscriptions (WS)
WS_ENABLED=true

# Healthcheck
HEALTHCHECK_PATH=/healthz

# Logging
LOG_LEVEL=info
