# Required
MONGODB_URI=mongodb://localhost:27017/eventsphere
JWT_SECRET=changeme-super-secret

# Optional
PORT=4000
NODE_ENV=development

# CORS: Prefer REACT_APP_FRONTEND_URL to allow frontend origin; fallback to CORS_ORIGIN
REACT_APP_FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Health
HEALTHCHECK_PATH=/healthz

# Logging
LOG_LEVEL=info
